<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{{ titulo_pagina }}</title>
<meta name="description" content="Acompanhamento da inserção curricular da extensão nos cursos de graduação da UFPB.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Saira:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="{{ raiz }}estilo.css">
<script src="{{ raiz }}plotly.min.js"></script>
<script src="{{ raiz }}tabela.js" defer></script>
<script src="{{ raiz }}filtro-centro.js" defer></script>
</head>
<body>
<a class="pular" href="#conteudo">Ir para o conteúdo</a>
<header class="topo">
  <div class="topo-interno">
    <img class="logo-ufpb" src="{{ raiz }}logo-ufpb.svg" alt="Brasão da Universidade Federal da Paraíba">
    <img class="logo-proex" src="{{ raiz }}logo-proex.png" alt="PROEX — Pró-Reitoria de Extensão/UFPB">
  </div>
</header>

<main id="conteudo">
  <section class="abertura">
    <h1>Análise Curricular<span>Inserção curricular da extensão</span></h1>
    <p class="lead">Situação da inserção curricular da extensão nos cursos de graduação da UFPB.</p>
    <p class="atualizacao">Dados atualizados em {{ atualizado_em }}</p>
  </section>

  <div class="filtro-centro">
    <label for="filtro-centro">Centro</label>
    <select id="filtro-centro" autocomplete="off" data-filtrado="{{ 1 if centro_atual else 0 }}" data-inicio="{{ raiz }}index.html">
      <option value="{{ raiz }}index.html"{% if not centro_atual %} selected{% endif %}>Todos</option>
      {% for c in todos_centros %}<option value="{{ raiz }}centro/{{ c.slug }}.html"{% if c.nome == centro_atual %} selected{% endif %}>{{ c.nome }}{% if c.descricao %} – {{ c.descricao }}{% endif %}</option>
      {% endfor %}
    </select>
    <noscript>
      <span class="chips-reserva">{% for c in todos_centros %}<a class="chip{% if c.nome == centro_atual %} ativo{% endif %}" href="{{ raiz }}centro/{{ c.slug }}.html">{{ c.nome }}</a> {% endfor %}<a class="chip" href="{{ raiz }}index.html">Todos</a></span>
    </noscript>
  </div>

  <section aria-labelledby="t-resumo">
    <h2 id="t-resumo">Visão geral</h2>
    <div class="cartoes">
      <div class="cartao cartao-total">
        <span class="numero">{{ n_ativos }}</span>
        <span class="rotulo">cursos ativos<span class="secundario">{{ n_fora }} cursos em extinção</span></span>
      </div>
      {% for s in status %}
      <div class="cartao">
        <span class="rotulo"><i class="marca" style="background: {{ cores[s.status] }}"></i>{{ s.rotulo }}</span>
        <span class="numero">{{ s.total }}</span>
        <span class="percentual">{{ "%.1f"|format(s.percentual)|replace(".", ",") }}% dos cursos ativos</span>
      </div>
      {% endfor %}
    </div>
    <p class="nota">Cada curso é contado uma única vez, pelo código e-MEC: cursos com mais de um turno contam como um só.<br>Os cursos com status em extinção não são computados nos totais e percentuais.</p>
  </section>

  <section aria-labelledby="t-centros">
    <h2 id="t-centros">Situação de implantação por Centro</h2>
    {% if grafico %}
    <div class="cartao-grande">
      {{ grafico|safe }}
      <details class="tabela-dados">
        <summary>Ver os dados do gráfico em tabela</summary>
        <div class="rolagem">
          <table>
            <thead>
              <tr><th scope="col">Centro</th>{% for s in prioridade %}<th scope="col" class="num">{{ rotulos[s] }}</th>{% endfor %}<th scope="col" class="num">Total</th></tr>
            </thead>
            <tbody>
              {% for l in tabela_centros %}
              <tr><th scope="row">{{ l.centro }}</th>{% for s in prioridade %}<td class="num">{{ l[s] }}</td>{% endfor %}<td class="num">{{ l.total }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </details>
    </div>
    {% else %}<p class="nota">Nenhum curso ativo neste Centro.</p>
    {% endif %}
  </section>

  <section aria-labelledby="t-periodo">
    <h2 id="t-periodo">Quantidade de cursos com inserção curricular da extensão por período</h2>
    {% if grafico_periodo %}
    <div class="cartao-grande">
      {{ grafico_periodo|safe }}
      {% if sem_periodo %}<p class="nota">{{ sem_periodo }} curso(s) implantado(s) sem período válido no PPC novo (não aparece(m) no gráfico).</p>{% endif %}
      <details class="tabela-dados">
        <summary>Ver os dados do gráfico em tabela</summary>
        <div class="filtros filtros-duplos">
          <label>Buscar curso
            <input type="search" id="i-busca" placeholder="Nome do curso ou código e-MEC">
          </label>
          <label>Centro
            <select id="i-centro">
              <option value="">Todos</option>
              {% for c in centros %}<option>{{ c }}</option>{% endfor %}
            </select>
          </label>
          <label>Período do PPC novo
            <select id="i-periodo">
              <option value="">Todos</option>
              {% for p in periodos if p.total %}<option>{{ p.periodo }}</option>{% endfor %}
            </select>
          </label>
        </div>
        <p class="contagem" aria-live="polite"><span id="contagem-periodo">{{ linhas_periodo|length }}</span> de {{ linhas_periodo|length }} cursos implantados</p>
        <div class="rolagem rolagem-alta">
          <table id="tabela-periodo">
            <thead>
              <tr><th scope="col">Centro</th><th scope="col">Curso</th><th scope="col">Código e-MEC</th><th scope="col">Período do PPC novo</th></tr>
            </thead>
            <tbody>
              {% for c in linhas_periodo %}
              <tr data-centro="{{ c.centro }}" data-periodo="{{ c.periodo }}" data-busca="{{ (c.curso ~ ' ' ~ c.emec)|lower }}">
                <td>{{ c.centro }}</td><td>{{ c.curso }}</td><td>{{ c.emec }}</td><td>{{ c.periodo }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </details>
    </div>
    {% else %}<p class="nota">Nenhum curso implantado com período do PPC novo neste Centro.</p>
    {% endif %}
  </section>

  <section aria-labelledby="t-oferta">
    <h2 id="t-oferta">Percentual dos componentes com extensão inseridos no Currículo</h2>
    {% if n_extensao %}
    {% if oferta.menores %}<p class="nota">Atenção: {{ oferta.menores }} curso(s) aparecem com oferta menor que a exigência; vale conferir na planilha.</p>{% endif %}

    <h3>Média da exigência de integralização pelo aluno e da oferta de carga horária de extensão por Centro</h3>
    <div class="cartao-grande">
      {{ grafico_oferta|safe }}
      <details class="tabela-dados">
        <summary>Ver os dados do gráfico em tabela</summary>
        <div class="filtros filtros-duplos">
          <label>Buscar curso
            <input type="search" id="o-busca" placeholder="Nome do curso ou código e-MEC">
          </label>
          <label>Centro
            <select id="o-centro">
              <option value="">Todos</option>
              {% for c in centros %}<option>{{ c }}</option>{% endfor %}
            </select>
          </label>
        </div>
        <p class="contagem" aria-live="polite"><span id="contagem-oferta">{{ linhas_oferta|length }}</span> de {{ linhas_oferta|length }} cursos</p>
        <div class="rolagem rolagem-alta">
          <table id="tabela-oferta">
            <thead>
              <tr>
                <th scope="col">Centro</th><th scope="col">Curso</th><th scope="col">Código e-MEC</th>
                <th scope="col" class="num">Carga horária do curso (h)</th><th scope="col" class="num">A integralizar (h)</th><th scope="col" class="num">% a integralizar</th>
                <th scope="col" class="num">Ofertado (h)</th><th scope="col" class="num">% ofertado</th><th scope="col" class="num">Margem (p.p.)</th>
              </tr>
            </thead>
            <tbody>
              {% for c in linhas_oferta %}
              <tr data-centro="{{ c.centro }}" data-busca="{{ (c.curso ~ ' ' ~ c.emec)|lower }}">
                <td>{{ c.centro }}</td><td>{{ c.curso }}</td><td>{{ c.emec }}</td>
                <td class="num">{{ c.horas_curso }}</td><td class="num">{{ c.horas_exigidas }}</td><td class="num">{{ c.pct_exigido }}</td>
                <td class="num">{{ c.horas_ofertadas }}</td><td class="num">{{ c.pct_ofertado }}</td><td class="num">{{ c.margem }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </details>
    </div>
    {% else %}<p class="nota">Nenhum curso deste Centro tem percentual de extensão.</p>
    {% endif %}
  </section>

  <section aria-labelledby="t-comp">
    <h2 id="t-comp">Distribuição da carga horária de extensão por componentes</h2>
    {% if n_extensao %}
    <div class="cartoes">
      <div class="cartao cartao-total">
        <span class="numero">{{ total_horas }}</span>
        <span class="rotulo">horas de extensão ofertadas em {{ n_extensao }} cursos</span>
      </div>
      {% for c in resumo_componentes %}
      <div class="cartao">
        <span class="rotulo"><i class="marca" style="background: {{ cores_componentes[c.chave] }}"></i>{{ c.rotulo }}</span>
        <span class="numero">{{ "%.1f"|format(c.percentual)|replace(".", ",") }}%</span>
        <span class="percentual">{{ c.horas }} h em {{ c.cursos }} curso(s)</span>
      </div>
      {% endfor %}
    </div>

    <h3>Distribuição por Centro</h3>
    <div class="cartao-grande">
      {{ grafico_componentes|safe }}
      <details class="tabela-dados">
        <summary>Ver os dados do gráfico em tabela</summary>
        <div class="filtros filtros-duplos">
          <label>Buscar curso
            <input type="search" id="c-busca" placeholder="Nome do curso ou código e-MEC">
          </label>
          <label>Centro
            <select id="c-centro">
              <option value="">Todos</option>
              {% for c in centros %}<option>{{ c }}</option>{% endfor %}
            </select>
          </label>
        </div>
        <p class="contagem" aria-live="polite"><span id="contagem-comp">{{ linhas_componentes|length }}</span> de {{ linhas_componentes|length }} cursos</p>
        <div class="rolagem rolagem-alta">
          <table id="tabela-componentes">
            <thead>
              <tr>
                <th scope="col">Centro</th><th scope="col">Curso</th><th scope="col">Código e-MEC</th>
                {% for k in componentes %}<th scope="col" class="num">{{ rotulos_componentes[k] }} (h)</th>{% endfor %}
                <th scope="col" class="num">Ofertado (h)</th><th scope="col" class="num">% em obrigatórios</th>
              </tr>
            </thead>
            <tbody>
              {% for c in linhas_componentes %}
              <tr data-centro="{{ c.centro }}" data-busca="{{ (c.curso ~ ' ' ~ c.emec)|lower }}">
                <td>{{ c.centro }}</td><td>{{ c.curso }}</td><td>{{ c.emec }}</td>
                {% for k in componentes %}<td class="num">{{ c[k] }}</td>{% endfor %}
                <td class="num">{{ c.total }}</td><td class="num">{{ c.obrigatorias }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </details>
    </div>
    {% else %}<p class="nota">Nenhum curso deste Centro tem percentual de extensão.</p>
    {% endif %}
  </section>

  <section aria-labelledby="t-uce">
    <h2 id="t-uce">Unidades Curriculares de Extensão (UCE)</h2>
    {% if n_extensao %}
    <div class="cartoes">
      <div class="cartao cartao-total">
        <span class="numero">{{ uce.com_uce }}</span>
        <span class="rotulo">de {{ uce.total }} cursos com nova Resolução publicada criaram UCEs</span>
      </div>
      <div class="cartao">
        <span class="rotulo"><i class="marca" style="background: {{ cor_uce }}"></i>UCEs criadas</span>
        <span class="numero">{{ uce.qtde }}</span>
      </div>
    </div>

    <h3>UCEs por Centro</h3>
    <div class="cartao-grande">
      {{ grafico_uce|safe }}
      <details class="tabela-dados">
        <summary>Ver os dados do gráfico em tabela</summary>
        <div class="filtros filtros-duplos">
          <label>Buscar curso
            <input type="search" id="u-busca" placeholder="Nome do curso ou código e-MEC">
          </label>
          <label>Centro
            <select id="u-centro">
              <option value="">Todos</option>
              {% for c in centros %}<option>{{ c }}</option>{% endfor %}
            </select>
          </label>
          <label>Situação
            <select id="u-situacao">
              <option value="">Todas</option>
              {% for k, r in rotulos_uce.items() %}<option value="{{ k }}">{{ r }}</option>{% endfor %}
            </select>
          </label>
        </div>
        <p class="contagem" aria-live="polite"><span id="contagem-uce">{{ linhas_uce|length }}</span> de {{ linhas_uce|length }} cursos</p>
        <div class="rolagem rolagem-alta">
          <table id="tabela-uce">
            <thead>
              <tr>
                <th scope="col">Centro</th><th scope="col">Curso</th><th scope="col">Código e-MEC</th>
                <th scope="col" class="num">UCEs</th><th scope="col" class="num">Carga horária (h)</th>
                <th scope="col" class="num">Créditos</th><th scope="col">Situação</th>
              </tr>
            </thead>
            <tbody>
              {% for c in linhas_uce %}
              <tr data-centro="{{ c.centro }}" data-situacao="{{ c.classe }}" data-busca="{{ (c.curso ~ ' ' ~ c.emec)|lower }}">
                <td>{{ c.centro }}</td><td>{{ c.curso }}</td><td>{{ c.emec }}</td>
                <td class="num">{{ c.qtde }}</td><td class="num">{{ c.horas }}</td><td class="num">{{ c.creditos }}</td><td>{{ c.situacao }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </details>
    </div>
    {% else %}<p class="nota">Nenhum curso deste Centro tem percentual de extensão.</p>
    {% endif %}
  </section>

  <section aria-labelledby="t-cursos">
    <h2 id="t-cursos">Cursos</h2>
    <div class="cartao-grande">
      <div class="filtros">
        <label>Buscar curso
          <input type="search" id="f-busca" placeholder="Curso, código e-MEC, processo ou resolução">
        </label>
        <label>Centro
          <select id="f-centro">
            <option value="">Todos</option>
            {% for c in centros %}<option>{{ c }}</option>{% endfor %}
          </select>
        </label>
        <label>Situação de implantação
          <select id="f-status">
            <option value="">Todas</option>
            {% for s in prioridade %}<option value="{{ s }}">{{ rotulos[s] }}</option>{% endfor %}
          </select>
        </label>
        <label>Situação do curso
          <select id="f-ativo">
            <option value="">Todas</option>
            <option value="1">Em atividade</option>
            <option value="0">Em extinção</option>
          </select>
        </label>
      </div>
      <p class="contagem" aria-live="polite"><span id="contagem">{{ n_cursos }}</span> de {{ n_cursos }} cursos</p>
      <div class="rolagem rolagem-alta">
        <table id="tabela-cursos">
          <thead>
            <tr>
              <th scope="col">Centro</th><th scope="col">Curso</th><th scope="col">Tipo</th><th scope="col">Sede</th>
              <th scope="col">Modalidade</th><th scope="col">Turnos</th><th scope="col">Código e-MEC</th>
              <th scope="col">Implantação</th><th scope="col">Processo SIPAC</th><th scope="col">Resolução CONSEPE</th><th scope="col">Situação do curso</th>
            </tr>
          </thead>
          <tbody>
            {% for c in cursos %}
            <tr data-centro="{{ c.centro }}" data-status="{{ c.status }}" data-ativo="{{ 1 if c.ativo else 0 }}" data-busca="{{ (c.curso ~ ' ' ~ c.emec ~ ' ' ~ c.processo ~ ' ' ~ c.resolucao)|lower }}"{% if not c.ativo %} class="inativo"{% endif %}>
              <td>{{ c.centro }}</td>
              <td>{{ c.curso }}</td>
              <td>{{ c.tipo }}</td>
              <td>{{ c.sede }}</td>
              <td>{{ c.modalidade }}</td>
              <td>{{ c.turnos }}</td>
              <td>{{ c.emec }}</td>
              <td><span class="selo"><i class="marca" style="background: {{ cores.get(c.status, '#888') }}"></i>{{ c.status_rotulo }}</span></td>
              <td class="nowrap">{{ c.processo }}</td>
              <td class="nowrap">{{ c.resolucao }}</td>
              <td>{% if c.ativo %}{{ c.situacao }}{% else %}<span class="aviso">{{ c.situacao }}</span>{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</main>

<footer class="rodape">
  <div class="rodape-interno">
    <div>
      <h2>Contato</h2>
      <p><a href="mailto:{{ contato.email }}">{{ contato.email }}</a></p>
      <p>Ramal: {{ contato.ramal }}</p>
      <p class="fonte">Pró-Reitoria de Extensão — Universidade Federal da Paraíba</p>
      {% if url_relatorio %}<p class="fonte"><a href="{{ url_relatorio }}" rel="noopener">Equipe PROEX: enviar relatório de ações prioritárias</a></p>{% endif %}
    </div>
    <div>
      <h2>Equipe</h2>
      <ul>
        {% for nome, cargo in equipe %}<li><strong>{{ nome }}</strong><span>{{ cargo }}</span></li>{% endfor %}
      </ul>
    </div>
  </div>
</footer>
</body>
</html>
